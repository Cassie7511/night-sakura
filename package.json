{
  "name": "cherry-blossom",
  "displayName": "Cherry Blossom",
  "description": "Dark and light VS Code themes in black, gray and cherry-blossom pink.",
  "version": "0.3.1",
  "publisher": "hunter-local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cassie7511/cherry-blossom-theme"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "build": "node build.js",
    "preview": "node preview.js",
    "package": "npx --yes @vscode/vsce package --allow-missing-repository"
  },
  "contributes": {
    "themes": [
      {
        "label": "Cherry Blossom",
        "uiTheme": "vs-dark",
        "path": "./themes/cherry-blossom-color-theme.json"
      },
      {
        "label": "Cherry Blossom Light",
        "uiTheme": "vs",
        "path": "./themes/cherry-blossom-light-color-theme.json"
      }
    ]
  }
}
